+	if err != nil {
+		t.Fatal(err)
+	}
+	defer response.Body.Close()
+	body, err := io.ReadAll(response.Body)
+	if err != nil || string(body) != content {
+		t.Fatalf("status = %d, body length = %d, error = %v", response.StatusCode, len(body), err)
+	}
