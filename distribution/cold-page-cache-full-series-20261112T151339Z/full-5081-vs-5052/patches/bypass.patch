+	content := strings.Repeat("0123456789", 1000)
+	fs := filesystem.New(filesystem.DriverParameters{RootDirectory: t.TempDir(), MaxThreads: 25})
+	if err := fs.PutContent(context.Background(), "/blob", []byte(content)); err != nil {
+		t.Fatal(err)
